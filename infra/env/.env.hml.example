# ===== HOMOLOGAÇÃO ===== modelo do .env.hml
ENV=hml
DEVICE_ID=estufa01-sim          # diferente do real, para nao acionar a estufa

# Postgres
POSTGRES_USER=estufa
POSTGRES_PASSWORD=TROQUE_senha_pg_hml
POSTGRES_DB=estufa_hml
DATABASE_URL=postgresql+psycopg://estufa:TROQUE_senha_pg_hml@postgres-hml:5432/estufa_hml

# MQTT (mesmo broker interno)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASS=TROQUE_senha_mqtt_backend

# Login do painel
AUTH_USER=admin
AUTH_PASS=TROQUE_senha_painel_hml
SESSION_SECRET=TROQUE_por_string_aleatoria_bem_longa_hml

# Sem e-mail no hml: o dispositivo simulado fica dias sem dados.
# Sem SMTP, o "Esqueci minha senha" fica desligado; a senha se troca com python -m app.senha.
SMTP_HOST=
ALERTA_EMAIL_PARA=
