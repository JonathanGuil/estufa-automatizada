# ===== PRODUÇÃO ===== modelo do .env.prod
ENV=prod
DEVICE_ID=estufa01

# Postgres
POSTGRES_USER=estufa
POSTGRES_PASSWORD=TROQUE_senha_pg_prod
POSTGRES_DB=estufa_prod
DATABASE_URL=postgresql+psycopg://estufa:TROQUE_senha_pg_prod@postgres-prod:5432/estufa_prod

# MQTT (broker interno)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASS=TROQUE_senha_mqtt_backend

# Login do painel: senha inicial (depois de trocada no painel, vale a do banco)
AUTH_USER=admin
AUTH_PASS=TROQUE_senha_painel_prod
SESSION_SECRET=TROQUE_por_string_aleatoria_bem_longa_prod

# Alertas e "Esqueci minha senha" por e-mail (opcional). Gmail: smtp.gmail.com, porta 587, senha de app.
# ALERTA_EMAIL_PARA e o e-mail inicial da conta; depois, ele e trocado no painel (Conta).
# PAINEL_URL vai nos links dos e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
ALERTA_EMAIL_DE=
ALERTA_EMAIL_PARA=
ALERTA_SEM_DADOS_MIN=15
PAINEL_URL=https://estufa.IP_DA_VM.sslip.io
